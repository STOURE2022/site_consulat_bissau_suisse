# ============================================================================
# Variables d'environnement — à définir dans Railway (onglet « Variables »).
# Copier ce fichier en « .env » pour un test en local ; ne jamais committer .env.
# ============================================================================

# Port d'écoute. Fourni automatiquement par Railway ; 3000 en local.
PORT=3000

# --- Serveur d'envoi d'e-mails (SMTP) ---------------------------------------
# De préférence un hébergeur suisse ou de l'Union européenne (conformité nLPD /
# RGPD), par exemple Infomaniak (mail.infomaniak.com) ou Mailbox.org.
# Tant que SMTP_HOST est vide, les demandes sont seulement journalisées.
SMTP_HOST=
SMTP_PORT=587
# true uniquement si le port est 465 (connexion SSL directe) ; sinon false.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Adresses e-mail --------------------------------------------------------
# Destinataire des demandes (boîte du consulat) et expéditeur technique.
MAIL_TO=contact@consulat-guineebissau.ch
MAIL_FROM=site@consulat-guineebissau.ch

# --- Base de données PostgreSQL (publications) ------------------------------
# Sur Railway : ajouter un service « PostgreSQL » ; la variable DATABASE_URL est
# alors injectée automatiquement — NE PAS la recopier ici à la main.
# Laisser vide en local désactive les publications (le site reste fonctionnel).
DATABASE_URL=
# Mettre "require" uniquement si vous utilisez une URL PostgreSQL PUBLIQUE
# (connexion externe chiffrée). Pour la connexion interne Railway, laisser vide.
PGSSL=

# --- Espace d'administration (publication d'informations) -------------------
# Identifiants de connexion à la page /admin. À définir impérativement pour
# pouvoir publier. Choisir un mot de passe long et unique.
ADMIN_USER=consul
ADMIN_PASSWORD=
# Comptes nominatifs supplémentaires (facultatif) : plusieurs personnes avec
# chacune son identifiant. Paires « identifiant:motdepasse » séparées par des
# virgules. Le mot de passe ne doit pas contenir de virgule.
# Exemple : ADMIN_USERS=leila:MotDePasseLong1,consul:MotDePasseLong2
ADMIN_USERS=
# Rôles : le consul a accès à tout (dont l'onglet « Mot du Consul ») ; les
# autres comptes ont accès à tout sauf cet onglet. Sont consuls : le compte
# ADMIN_USER ci-dessus, plus les identifiants listés ici (séparés par des
# virgules). Laisser vide si seul ADMIN_USER est consul.
# Exemple : ADMIN_CONSULS=consul,riccardo
ADMIN_CONSULS=
